name: Build and publish harp-fe image

on:
  push:
    branches: [ main ]
    paths:
      - 'harp-ui/**'
      - '.github/workflows/ui-build.yml'
  workflow_dispatch:
    inputs:
      deploy:
        description: 'Deploy UI to k8s after build?'
        required: true
        default: 'false'
        type: choice
        options:
          - 'true'
          - 'false'

concurrency:
  group: build-and-push-harp-fe
  cancel-in-progress: true

jobs:
  build:
    name: Build and push harp-fe image
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
      id-token: write

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Set up QEMU
        uses: docker/setup-qemu-action@v2

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v2

      - name: Login to GitHub Container Registry
        uses: docker/login-action@v2
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      # Removed GHA Docker Cache to ensure a 100% clean build of the new image name
      - name: Build and push UI (multi-arch)
        uses: docker/build-push-action@v4
        with:
          context: ./harp-ui
          file: ./harp-ui/Dockerfile
          platforms: linux/amd64,linux/arm64
          push: true
          tags: |
            ghcr.io/${{ github.repository_owner }}/harp-fe:latest
            ghcr.io/${{ github.repository_owner }}/harp-fe:${{ github.sha }}

  deploy:
    name: Deploy to Kubernetes
    needs: build
    # Ensuring this runs if you push to main OR dispatch
    if: github.ref == 'refs/heads/main' || (github.event_name == 'workflow_dispatch' && github.event.inputs.deploy == 'true')
    runs-on: ubuntu-latest
    steps:
      - name: Configure kubeconfig
        run: |
          echo "${{ secrets.KUBE_CONFIG_DATA }}" | base64 --decode > $HOME/.kube/config

      - name: Update Deployment Image
        run: |
          # We change the image source in the deployment to the new 'harp-fe' name
          kubectl -n harp set image deployment/harp-ui harp-ui=ghcr.io/${{ github.repository_owner }}/harp-fe:latest
          kubectl -n harp rollout restart deployment/harp-ui
          kubectl -n harp rollout status deployment/harp-ui --timeout=120s