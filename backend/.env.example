# Database connection (required in production)
DB_HOST=ekskog.xyz
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=

# Optional: allow using defaults if envs not provided (false by default)
# Set to 'true' to permit the service to use internal defaults. Prefer setting explicit DB envs.
DB_ALLOW_DEFAULTS=false

# Enable DB debug logging
DB_DEBUG=false
